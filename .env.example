BOT_TOKEN=
# Jobs at once. Empty: 1 on hosts with at most 768 MB of memory (Render Free),
# where one YouTube job needs the bot, its worker and Deno together; else 2.
MAX_CONCURRENT_JOBS=
MAX_PENDING_JOBS=20
MAX_GALLERY_ITEMS=100
MAX_SOURCE_BYTES=4294967296
JOB_TIMEOUT_SECONDS=3600
# Public Telegram custom emoji set for status messages. Leave empty to disable.
STATUS_EMOJI_PACK=LoadingEmoji
# Longest accepted video or audio (seconds). Four hours covers three-hour videos.
MAX_MEDIA_SECONDS=14400
# Photos are always delivered as Telegram photos, not documents.
# Optional network troubleshooting; affects sending AND polling.
TELEGRAM_IPV4=1
TELEGRAM_PROXY=
# Termux configures the owner's Render relay at first start.
# To opt out, add TELEGRAM_RELAY_BASE=0 to .env.
# Optional owner-supplied Netscape cookie files, never send these in chat.
# On Render use Secret Files named <platform>_cookies.txt, e.g. youtube_cookies.txt
# (see docs/OPERATIONS.md#youtube-sign-in).
INSTAGRAM_COOKIE_FILE=
YOUTUBE_COOKIE_FILE=
PINTEREST_COOKIE_FILE=
SNAPCHAT_COOKIE_FILE=
# Optional owner-operated or explicitly authorized Cobalt API. No public default.
# The API key is sent only to this endpoint, never to source media/CDN hosts.
COBALT_API_URL=
COBALT_API_KEY=
# Optional Newisty public API for an individual YouTube video after a bot check.
# Shares only the canonical video link. Off by default on new installations.
NEWISTY_YOUTUBE=0
# Optional VidFetch account key for single public videos. Provider plan limits apply.
VIDFETCH_API_KEY=
# Optional 2 GB uploads: create an app at https://my.telegram.org (API development
# tools) and set both values. Files over 50 MB are then uploaded by the same bot
# over MTProto instead of being split into 49 MB parts. Keep them secret.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Render Free keeps itself awake while a job runs. KEEP_AWAKE=1 also keeps an
# idle bot warm (no cold start), using the plan's monthly instance hours.
KEEP_AWAKE=0
# V8 flags for Deno, which solves YouTube's player challenges. Empty uses
# --max-semi-space-size=1 (about 215 MB instead of 280 MB at its peak).
DENO_V8_FLAGS=
# Seconds between new jobs that use an owner account (cookies) on one platform.
ACCOUNT_SPACING_SECONDS=5
# Optional: existing local Bot API server. Keep empty for api.telegram.org.
TELEGRAM_API_BASE=
PORT=10000
