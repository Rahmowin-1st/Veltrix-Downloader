BOT_TOKEN=
MAX_CONCURRENT_JOBS=1
MAX_PENDING_JOBS=20
MAX_GALLERY_ITEMS=100
MAX_SOURCE_BYTES=4294967296
JOB_TIMEOUT_SECONDS=1800
# Photos are always delivered as Telegram photos, not documents.
# Optional network troubleshooting; affects sending AND polling.
TELEGRAM_IPV4=1
TELEGRAM_PROXY=
# Termux configures the owner's Render relay at first start.
# To opt out, add TELEGRAM_RELAY_BASE=0 to .env.
# Optional owner-supplied Netscape cookie files, never send these in chat.
INSTAGRAM_COOKIE_FILE=
YOUTUBE_COOKIE_FILE=
PINTEREST_COOKIE_FILE=
SNAPCHAT_COOKIE_FILE=
# Optional hosted fallbacks. Setting a key enables provider credit usage only
# after local extractors fail. Keys are never sent to media CDN hosts.
# YouTube: https://developers.tunelio.dev/ (trial requires an account)
TUNELIO_API_KEY=
# Snapchat public videos: https://apify.com/convertfleetdotonline/snapchat-downloader
# Runs are capped at $0.02 and 120 seconds; no platform credentials are shared.
APIFY_TOKEN=
# Optional: existing local Bot API server. Keep empty for api.telegram.org.
TELEGRAM_API_BASE=
PORT=10000
